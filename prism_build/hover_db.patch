+static void drawDbHover(HDC dc,i32 w,i32 h){
+    POINT pt; if(!GetCursorPos(&pt))return; if(!ScreenToClient(g_hwnd,&pt))return;
+    if(pt.x<0||pt.y<0||pt.x>=w||pt.y>=h)return;
+    i32 fx=(i32)((i64)pt.x*FBW/(w?w:1)), fy=(i32)((i64)pt.y*FBH/(h?h:1));
+    if(fx<FIELD_X0||fx>FIELD_X1||fy<FIELD_TOP||fy>FIELD_BASE)return;
+
+    f32 db=DB_FLOOR;
+    if(g_displayMode==1 && g_tfCount>0){
+        i32 f=(fx-FIELD_X0)*HEAT_FREQ/(FIELD_X1-FIELD_X0); if(f<0)f=0;if(f>=HEAT_FREQ)f=HEAT_FREQ-1;
+        i32 age=(FIELD_BASE-fy)*g_tfCount/(FIELD_BASE-FIELD_TOP); if(age<0)age=0;if(age>=g_tfCount)age=g_tfCount-1;
+        i32 idx=(g_tfWrite-1-age+HEAT_TIME)%HEAT_TIME;
